# ====================================================================
# MOSHOOD ABIOLA NATIONAL STADIUM TMS - ENVIRONMENT CONFIGURATION
# ====================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection Options
# Option 1: Full Connection URI (Recommended for Neon, Supabase, Render, Railway, ElephantSQL, or Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/man_stadium_tms

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=man_stadium_tms
PGUSER=postgres
PGPASSWORD=postgres

# Session / Cookie Secret
SESSION_SECRET=man_stadium_secure_secret_key_2026
